# ============================================================================
# ElderAssist AI — environment configuration
# ============================================================================
# Copy this file to `.env` (the setup script does this for you) and edit the
# values below. Every setting has a sensible default; a fresh family install
# usually only needs to set TZ.
#
#   cp .env.example .env
#
# `.env` is git-ignored on purpose — it is yours and may hold secrets later.
# ============================================================================


# --- Timezone --------------------------------------------------------------
# Used by EVERY container so reminders and logs use the elder's local time.
# Must be a valid tz database name, e.g. America/New_York, Europe/London,
# America/Chicago. Find yours: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=America/New_York


# --- Compose project + profiles -------------------------------------------
# COMPOSE_PROJECT_NAME namespaces the containers and the named volumes
# (e.g. the Home Assistant volume becomes `elderassist_ha_config`). The backup
# and restore scripts rely on this exact name — change it only if you know why.
COMPOSE_PROJECT_NAME=elderassist

# Optional add-on profiles, comma-separated. Leave empty for the core stack
# (Home Assistant + Ollama + kiosk). The setup script rewrites this line when
# you pass --voice / --inventory / --grocy / --webui / --all.
#   voice     -> local wake word + speech-to-text + text-to-speech
#   inventory -> HomeBox (appliances, serials, warranties, manuals)
#   grocy     -> Grocy (medication stock, groceries, chores)
#   webui     -> Open WebUI (optional operator chat UI for Ollama)
# Example: COMPOSE_PROFILES=voice,inventory
COMPOSE_PROFILES=


# --- Local LLM (Ollama) ----------------------------------------------------
# The model Ollama pulls and serves. Default is a capable 8B-class model that
# runs well on a 16 GB mini-PC.
#   qwen3:8b        default, best all-round on recommended hardware
#   llama3.1:8b     strong alternative, larger community
#   qwen3:4b        smaller/faster for 8 GB machines (some quality loss)
#   llama3.2:3b     smallest usable, for weak hardware (slow-but-works)
# Swap any time: edit this, then `docker compose exec ollama ollama pull <model>`.
OLLAMA_MODEL=qwen3:8b


# --- Local vision model — "Read This For Me" camera (voice/D11) ------------
# A vision-language model Ollama serves so the kiosk can read a photographed
# label, letter, bill, or expiry date aloud. Pulled by `./setup.sh --vision`
# (or --all). qwen2.5vl:7b is a capable default; use a smaller VL model on weak
# hardware. It is NOT downloaded unless you ask for vision.
OLLAMA_VISION_MODEL=qwen2.5vl:7b

# Shared secret that unlocks the kiosk's locked-down Ollama proxy. The kiosk
# nginx service ONLY forwards a request to Ollama when it carries this exact
# value in an X-Kiosk-Key header; if this is blank the proxy is CLOSED and always
# returns 403 (secure by default). Leave it empty and `./setup.sh --vision` will
# generate a random one for you (openssl / urandom). Honest threat model: this
# key ends up readable in pwa/config.js on the tablet, exactly like the Home
# Assistant token — anyone with the key AND LAN access can use the local vision
# model. Low harm (no cloud, no cost), but keep the app LAN-only. See pwa/README.md.
KIOSK_OLLAMA_KEY=


# --- Ports -----------------------------------------------------------------
# Host ports each service is reachable on. Defaults avoid common conflicts.
# On Linux, Home Assistant uses host networking and always binds HA_PORT
# directly; on macOS/Windows the compose file maps it (see docker-compose.yml).

# Home Assistant web UI + Assist API                http://<hub>:8123
HA_PORT=8123

# Ollama HTTP API (OpenAI-compatible)               http://<hub>:11434
OLLAMA_PORT=11434
# Ollama's API is UNAUTHENTICATED. It is bound to loopback (127.0.0.1) by default
# so nothing on the LAN can reach it. Only set this to 0.0.0.0 if another host
# needs it (e.g. Hermes running on a different machine from the hub).
OLLAMA_BIND=127.0.0.1

# Kiosk PWA — the six-giant-button elder app        http://<hub>:8880
KIOSK_PORT=8880

# Voice profile — Wyoming protocol services (TCP). Keep these equal to the
# containers' internal ports so Home Assistant can reach them the same way
# whether it runs on host networking (Linux) or bridged (macOS/Windows).
WHISPER_PORT=10300
PIPER_PORT=10200
WAKEWORD_PORT=10400

# Inventory profile — HomeBox web UI                http://<hub>:7745
HOMEBOX_PORT=7745

# Grocy profile — Grocy web UI                      http://<hub>:9283
GROCY_PORT=9283

# WebUI profile — Open WebUI operator chat          http://<hub>:3000
OPENWEBUI_PORT=3000
# Open WebUI is bound to loopback (127.0.0.1) by default. Set to 0.0.0.0 only if
# you need to open the operator chat from another host on the LAN.
WEBUI_BIND=127.0.0.1


# --- Voice models (voice profile only) ------------------------------------
# Whisper speech-to-text model. base-int8 is a good CPU default; use
# tiny-int8 on weak hardware or small-int8/medium-int8 for better accuracy.
WHISPER_MODEL=base-int8
# Whisper language (ISO code) or "auto".
WHISPER_LANGUAGE=en
# Piper text-to-speech voice. en_US-lessac-medium is clear and pleasant.
# Browse voices: https://rhasspy.github.io/piper-samples/
PIPER_VOICE=en_US-lessac-medium
# openWakeWord model. "ok_nabu" is the Home Assistant default wake word.
WAKEWORD_MODEL=ok_nabu
