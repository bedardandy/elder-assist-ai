# ============================================================================
# ElderAssist — Hermes Agent environment (skills + integrations)
# ============================================================================
# These are the secrets and endpoints the ElderAssist persona (AGENTS.md) and
# the six skills in hermes/skills/ read at runtime.
#
# Hermes keeps real secrets in its own file: ~/.hermes/.env  (Linux/macOS) or
# %LOCALAPPDATA%\hermes\.env (Windows). This file is a TEMPLATE. Copy the values
# you need into the Hermes .env — either by hand, or with:
#
#     hermes config set HASS_TOKEN eyJ....         # lands in ~/.hermes/.env
#     hermes config set HOMEBOX_TOKEN ...
#
# Do NOT commit a filled-in copy. Keep ~/.hermes/.env at chmod 600, non-root.
# Restart the gateway after editing — Hermes only reads env at process start.
# ============================================================================


# --- Home Assistant (PRIMARY actuator) -------------------------------------
# Hermes's native `homeassistant` toolset auto-enables the moment HASS_TOKEN is
# set, and exposes ha_list_entities / ha_get_state / ha_list_services /
# ha_call_service. HASS_URL / HASS_TOKEN are the names Hermes itself reads.
#
# The token MUST be a Home Assistant *Long-Lived Access Token* for a RESTRICTED,
# NON-ADMIN user (HA → profile → Security → Long-lived access tokens → Create).
# Short-lived UI session tokens do not work. Same restricted user the kiosk PWA
# uses is fine.
HASS_URL=http://homeassistant.local:8123
HASS_TOKEN=PASTE_A_RESTRICTED_USER_LONG_LIVED_TOKEN_HERE

# Skills fall back to raw HA REST curl calls (so they keep working even if a
# future Hermes changes the toolset). Those curl patterns read HA_URL / HA_TOKEN.
# KEEP THESE IDENTICAL to HASS_URL / HASS_TOKEN above. Env substitution works in
# config.yaml but not across .env lines, so paste the same values here.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=PASTE_A_RESTRICTED_USER_LONG_LIVED_TOKEN_HERE


# --- HomeBox (durable-goods system of record) ------------------------------
# Appliances, serial numbers, warranties, manuals. Used by the memory-book skill.
# Base URL of your HomeBox instance (no trailing slash). Token: log in to HomeBox
# and mint an API token, or use a login-issued bearer token. HomeBox's API is at
# ${HOMEBOX_URL}/api/v1/... with `Authorization: Bearer <token>`.
HOMEBOX_URL=http://homebox.local:7745
HOMEBOX_TOKEN=


# --- Grocy (optional: medication + grocery stock) --------------------------
# Only needed if you run the `grocy` compose profile. Used by medication-refill
# for stock checks. Grocy auth header is `GROCY-API-KEY: <key>` (NOT bearer).
# Create the key in Grocy → Settings → Manage API keys. API base is ${GROCY_URL}/api.
# Leave GROCY_URL empty to make the skills fall back to a spoken stock dialogue.
GROCY_URL=
GROCY_API_KEY=


# --- People ----------------------------------------------------------------
# The elder this companion serves, and the primary caregiver, by name. These fill
# the {ELDER_NAME} / {CAREGIVER_NAME} placeholders in AGENTS.md and the skills.
ELDER_NAME=Mary
CAREGIVER_NAME=Susan

# Where escalations and caregiver notifications go. This is a Hermes delivery
# target: a platform name (signal | whatsapp | telegram | email), optionally
# scoped to a recipient/group. Examples:
#   CAREGIVER_CHANNEL=signal              # the paired Signal owner/group
#   CAREGIVER_CHANNEL=telegram            # the Telegram allowed user(s)
#   CAREGIVER_CHANNEL=signal,telegram     # fan out to both
# It is used by the cron `--deliver`/delivery target and by the notify tool.
CAREGIVER_CHANNEL=signal


# ============================================================================
# Channel / gateway credentials (set the ones you use — see hermes/README.md)
# ============================================================================
# These are read by `hermes gateway`. Configure with `hermes gateway setup`, or
# paste here. ALWAYS set an allowlist — never GATEWAY_ALLOW_ALL_USERS=true.

# Global allowlist fallback (comma-separated platform user IDs). Prefer the
# per-platform lists below and DM pairing (`hermes pairing approve ...`).
# GATEWAY_ALLOWED_USERS=

# --- Signal (recommended for the elder: no account, links to a phone) ------
# Runs signal-cli as a local daemon; Hermes talks to it over HTTP/JSON-RPC.
# SIGNAL_HTTP_URL=http://127.0.0.1:8080
# SIGNAL_ACCOUNT=+15551230000
# SIGNAL_ALLOWED_USERS=+15551234567,+15559876543
# SIGNAL_GROUP_ALLOWED_USERS=            # a group ID, or * to allow the family group

# --- Telegram (easy for family) --------------------------------------------
# Create a bot with @BotFather (/newbot); find your numeric ID via @userinfobot.
# For a family GROUP, disable BotFather Group Privacy or make the bot admin.
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_ALLOWED_USERS=123456789,987654321

# --- WhatsApp (Baileys bridge; run `hermes whatsapp` to pair by QR) ---------
# WHATSAPP_ENABLED=true
# WHATSAPP_MODE=bot                       # "bot" (dedicated number) or "self-chat"
# WHATSAPP_ALLOWED_USERS=15551234567      # country code, NO leading +
